{
  "name": "surgio-rules-template",
  "version": "1.0.0",
  "description": "一份订阅链接，生成按规则分流的 Clash / QuantumultX 配置。基于 Surgio 的开源模板，填入自己的订阅即可用。",
  "license": "MIT",
  "private": false,
  "scripts": {
    "generate": "NODE_OPTIONS=\"--require ./dns-fix.js\" surgio generate",
    "generate:nofix": "surgio generate",
    "build:rules": "NODE_OPTIONS=\"--require ./dns-fix.js\" node scripts/build-rules.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "surgio": "^3.17.0"
  }
}
