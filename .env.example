# ============================================================
#  复制本文件为 .env，然后把下面的值换成你自己的机场订阅链接。
#  .env 已被 .gitignore 忽略，不会被提交到仓库，请放心填。
# ============================================================

# 你的机场「Clash 订阅链接」。
# 一般在机场后台/订阅页面能复制到，形如：
#   https://your-airport.com/link/xxxxxxxx?clash=1
# 或：
#   https://sub.your-airport.com/api/v1/client/subscribe?token=xxxxxxxx
AIRPORT_SUBSCRIPTION_URL=

# ============================================================
#  可选：自建 Trojan 节点（VPS）。填了才会生成 dist/Clash-Tr.yaml
#  和 dist/QuantumultX-Tr.conf；不填就当没有这一段，不影响上面的机场配置。
#  密码写在这里是安全的：.env 已被 .gitignore 忽略，不会进 git。
#  ⚠️ 绝对不要把密码写进 generate.sh、surgio.conf.js 或任何被 git 跟踪的文件。
# ============================================================

# 节点域名（也是默认的 SNI）
TROJAN_HOST=
# 端口，默认 443
TROJAN_PORT=443
# Trojan 密码
TROJAN_PASSWORD=
# SNI，不填就用 TROJAN_HOST
TROJAN_SNI=
# 节点显示名，不填就是 US Trojan VPS
TROJAN_NODE_NAME=
